# The Prisma client is generated to lib/generated/prisma (outside node_modules).
# Under pnpm's strict, non-hoisted layout the generated client cannot resolve
# @prisma/client's internal transitive packages (e.g. @prisma/client-runtime-utils).
# Hoist all @prisma/* packages to the root so the generated client resolves them.
public-hoist-pattern[]=@prisma/*
